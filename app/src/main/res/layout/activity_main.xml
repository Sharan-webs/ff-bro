<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#000000">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FF AIMBOT MASTER"
        android:textSize="32sp"
        android:textColor="#ff0000"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <LinearLayout
        android:id="@+id/permission_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/overlay_perm_button"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Overlay Permission"
            android:textSize="16sp"
            android:background="#ff0000"
            android:textColor="#ffffff"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/accessibility_perm_button"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Accessibility Service"
            android:textSize="16sp"
            android:background="#ff0000"
            android:textColor="#ffffff"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grant permissions..."
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/start_overlay_button"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="START AIMBOT"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#00ff00"
        android:textColor="#000000"
        android:enabled="false" />

    <LinearLayout
        android:id="@+id/control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aimbot running..."
            android:textSize="14sp"
            android:textColor="#ffff00" />

    </LinearLayout>

</LinearLayout>
